# Required
DATABASE_URL=postgresql://user:pass@host:5432/railway
SECRET_KEY=replace-with-long-random-string

# Owner bootstrap (first boot creates owner if missing)
M3_OWNER_EMAIL=owner@example.com
M3_OWNER_PASSWORD=replace-me
M3_OWNER_NAME=Owner

# Optional fallbacks used only for owner bootstrap
# APP_EMAIL=
# APP_PASSWORD=

# Data / uploads
M3_DATA_ROOT=/data

# Keep disabled until owner authorizes
# SAM live, BidNet, Euna, paid research — off by default in code
