# Get a free key at https://sam.gov → sign in → Account Details → Public API Key
SAM_GOV_API_KEY=your_key_here

# Fallback NAICS list if none saved in Settings (19 codes across 3 tiers)
# LEGACY ONLY — facilities-service subcontracting dashboard / SAM sync.
# M3 government product-resale does NOT use NAICS_CODES; see m3_procurement_profile.py
# and product_discovery.PRODUCT_DISCOVERY_NAICS (metadata only, not primary filter).
NAICS_CODES=561720,561210,561730,561710,562111,561790,561740,562119,561439,541930,811192,238220,562910,484210,484110,492110,711320,532490,561422
MIN_DAYS_UNTIL_DUE=10
MIN_SCORE_THRESHOLD=1

# PostgreSQL — use DATABASE_PUBLIC_URL from Railway (for local dev on your PC)
DATABASE_URL=your_railway_postgres_url_here

# OpenAI API — contract screening, proposals, agreements (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
# Tiered models (funnel routing) — prefer these over OPENAI_MODEL
OPENAI_MODEL_CHEAP=gpt-5.6-luna
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_PREMIUM=gpt-5.6-sol
# Stage 1 compactness
AI_STAGE1_MAX_OUTPUT_TOKENS=400
AI_STAGE1_TARGET_INPUT_CHARS=3500
AI_STAGE1_MAX_INPUT_CHARS=12000
# Company eligibility (update when certifications change)
COMPANY_CERTIFICATIONS=SB,SMALL_BUSINESS,TOTAL_SMALL_BUSINESS,SBA
COMPANY_UNSUPPORTED_SET_ASIDES=WOSB,EDWOSB,SDVOSB,VOSB,HUBZONE,HUB Zone,8(a),8A,8a
AI_MIN_ACTUAL_PROFIT_USD=10000
# Legacy single-model override (optional; router prefers tiers)
# OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH_ENABLED=false
OPENAI_REQUEST_TIMEOUT=120

# Dollar budget — primary spend control (~$40/month total OpenAI)
AI_MONTHLY_DOLLAR_BUDGET=40.00
AI_DAILY_DOLLAR_SOFT_LIMIT=1.00
AI_BUDGET_STAGE1_PERCENT=20
AI_BUDGET_STAGE2_PERCENT=20
AI_BUDGET_STAGE3_PERCENT=25
AI_BUDGET_STAGE4_PERCENT=20
AI_BUDGET_STAGE5_PERCENT=15

# Login — email and password (required for Railway / public access)
APP_EMAIL=you@example.com
APP_PASSWORD=your_password_here
# Optional separate password for CSV upload API when not logged in (defaults to APP_PASSWORD)
CSV_UPLOAD_PASSWORD=your_upload_password_here
# Max SAM ContractOpportunitiesFullCSV upload size in MB (dashboard modal)
CSV_UPLOAD_MAX_MB=250
# Pause CSV attachment downloads when this fraction of SAM daily budget is used (default 0.8)
CSV_ATTACHMENT_BUDGET_THRESHOLD=0.8
SECRET_KEY=generate_a_long_random_string

# Daily auto-sync at 6am (America/Denver) — tiered: T1 daily, T2 Mon/Wed/Fri, T3 Sunday
SCHEDULER_ENABLED=true
DAILY_REFRESH_HOUR=6
DAILY_REFRESH_MINUTE=0
SCHEDULER_TIMEZONE=America/Denver

# Google Places API (New) — for Sub Finder
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# API budgets
# SAM.gov search + attachment metadata
# SAM.gov API — scarce late-stage verification (NOT routine discovery)
SAM_API_CALL_LIMIT=10
SAM_DAILY_API_BUDGET=10
SAM_SCARCITY_MODE=true
# Rare controlled NAICS/product SAM discovery only (default off)
SAM_ALLOW_BROAD_DISCOVERY=false
SAM_API_BROAD_DISCOVERY_ENABLED=false
SAM_PDF_DOWNLOAD_BUDGET=0
SCHEDULED_NAICS_PER_SYNC=1
# AI screening count budget (legacy compatibility — dollar budget is primary)
AI_DAILY_SCREEN_BUDGET=25
# Automatic AI intake after sync/attachments — keep false unless you want paid auto-analysis
INTAKE_ON_SYNC=false
# Opening contract detail auto-triggers screening — MUST stay false by default
AUTO_SCREEN_ON_CONTRACT_DETAIL=false
INTAKE_PER_SYNC_LIMIT=2
FULL_ANALYSIS_MIN_SCORE=6
ATTACHMENT_ENRICH_PER_SYNC_LIMIT=0
# Attachments-only window for 6am sync (inclusive).
# SCHEDULED_SYNC_ATTACHMENTS_ONLY_FROM=2026-07-03
# SCHEDULED_SYNC_ATTACHMENTS_ONLY_UNTIL=2026-07-03
# CSV-only SAM attachment mode — when true, SAM attachment pulls skip dashboard contracts (default false).
# SAM_ATTACHMENTS_CSV_ONLY=false
# SAM_ATTACHMENTS_CSV_ONLY_UNTIL=2026-07-10
